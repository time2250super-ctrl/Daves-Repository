HF_TOKEN=
# Fits ~4–6 GB RAM. Do not use 7B/8B checkpoints on this profile.
# Instruct model so the assistant holds a real conversation out of the box.
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
ASSISTANT_NAME=Nova
# Leave empty to use the built-in Nova persona. Override to fully replace it.
SYSTEM_PROMPT=
# Browser TTS prefers a female-sounding system voice when available.
BROWSER_VOICE_HINT=female
USE_QLORA=0
EPOCHS=1
BATCH_SIZE=1
GRAD_ACCUM=2
MAX_SEQ_LEN=256
MAX_NEW_TOKENS=96
LR=2e-4
LORA_R=8
