HF_TOKEN=
# ~1.5B instruct model: sharper replies, needs ~7-8 GB RAM (see docker-compose
# mem_limit). Drop to Qwen/Qwen2.5-0.5B-Instruct for the ~4-6 GB profile.
# Avoid 7B/8B checkpoints on a CPU/low-RAM box.
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
ASSISTANT_NAME=Nova
# Leave empty to use the built-in Nova persona. Override to fully replace it.
SYSTEM_PROMPT=
# Browser TTS prefers a female-sounding system voice when available.
BROWSER_VOICE_HINT=female
USE_QLORA=0
EPOCHS=1
BATCH_SIZE=1
GRAD_ACCUM=2
MAX_SEQ_LEN=256
MAX_NEW_TOKENS=96
LR=2e-4
LORA_R=8
