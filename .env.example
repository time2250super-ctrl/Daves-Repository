HF_TOKEN=
# Default is a small instruct model that holds a real conversation. On CPU it
# needs ~8 GB RAM (fp32). For the ~4-6 GB profile, drop to Qwen2.5-0.5B-Instruct.
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
ASSISTANT_NAME=Nova
# Leave empty to use the built-in Nova persona. Override to fully replace it.
SYSTEM_PROMPT=
# Browser TTS prefers a female-sounding system voice when available.
BROWSER_VOICE_HINT=female
EPOCHS=1
BATCH_SIZE=1
GRAD_ACCUM=2
MAX_SEQ_LEN=256
MAX_NEW_TOKENS=96
LR=2e-4
LORA_R=8
SEED=42
